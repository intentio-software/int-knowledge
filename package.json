{
  "name": "int-knowledge",
  "version": "1.5.0",
  "description": "Intentio Knowledge — a local-first markdown vault with MCP built in.",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "tauri": "tauri",
    "mcp:build": "cargo build --release -p int-knowledge-mcp",
    "test:rust": "cargo test",
    "test:ui": "esbuild scripts/verify-frontend.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/verify-frontend.cjs --log-level=error && node node_modules/.cache/verify-frontend.cjs",
    "test": "npm run test:ui && cargo test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "20.3.18",
    "@angular/cdk": "20.2.14",
    "@angular/common": "20.3.18",
    "@angular/compiler": "20.3.18",
    "@angular/core": "20.3.18",
    "@angular/forms": "20.3.18",
    "@angular/platform-browser": "20.3.18",
    "@angular/router": "20.3.18",
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.7.0",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.35.0",
    "@lezer/highlight": "^1.2.0",
    "@primeng/themes": "^20.5.0-lts",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "markdown-it": "^14.3.0",
    "primeflex": "^4.0.0",
    "primeicons": "^7.0.0",
    "primeng": "20.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "20.3.20",
    "@angular/cli": "20.3.20",
    "@angular/compiler-cli": "20.3.18",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@types/markdown-it": "^14.1.2",
    "semantic-release": "^24.0.0",
    "typescript": "~5.8.3"
  }
}
