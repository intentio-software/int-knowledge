{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Intentio Knowledge",
  "version": "0.1.0",
  "identifier": "com.intentio.knowledge",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/int-knowledge/browser"
  },
  "app": {
    "windows": [
      {
        "title": "Intentio Knowledge",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENERjhDRjQ2OTMxODAyNDQKUldSRUFoaVRScy80emNWMmdHcVY2cnZhKzFCVzJNcTlpSjJTRVpHYjA4OHpDcFppQTZGSmdXam0K",
      "endpoints": [
        "https://github.com/intentio-software/int-knowledge/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": "v1Compatible",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
